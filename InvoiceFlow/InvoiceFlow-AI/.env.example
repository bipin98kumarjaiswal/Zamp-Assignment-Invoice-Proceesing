# Copy to .env for local development. NEVER commit the real .env file.

# Database. Leave unset to use a local SQLite file at data/invoiceflow.db.
# Hosted example (Supabase session pooler):
DATABASE_URL=postgresql://postgres.qugsdlizwwxoyrupzgzf:Bipin9721jaiswal@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Business rules (defaults shown)
PRICE_TOLERANCE_PCT=2.0          # allowed unit-price variance vs PO, and PO-balance overrun as % of PO value
ARITHMETIC_TOLERANCE=0.02        # absolute rounding tolerance when re-adding invoice numbers
MIN_FIELD_CONFIDENCE=0.80        # critical fields below this confidence force REVIEW

# Files
MAX_FILE_MB=5
MAX_PAGES=10
OCR_ENABLED=true
OCR_DPI=200

# Optional AI-assisted extraction (off by default; the app works fully without it)
USE_AI_EXTRACTION=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# UI
ALLOW_DB_RESET=true              # shows the "Reset demo database" button. Set false on a shared/public deployment.
UI_STAGE_PAUSE=0.18              # cosmetic pause (seconds) between stages in the live view; 0 disables

# Admin-only demo controls (set a strong value in Streamlit Secrets on deployment)
# ADMIN_PASSWORD=
